---
import '../styles/global.css';
import { contact, nav, site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  hideHeader?: boolean;
  noindex?: boolean;
}

const { title, description, hideHeader = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="theme-color" content="#090909" />
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          root.classList.add("js");
          var light = localStorage.getItem("theme") === "light";
          if (light) root.classList.add("light");
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", light ? "#faf7f2" : "#090909");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {!hideHeader && (
    <header class="site-header">
      <a class="wordmark" href="/">{site.name}</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li>
            <a class="contact-link" href={contact.href}>{contact.label}</a>
          </li>
          <li>
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme">
              <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
              <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
            </button>
          </li>
        </ul>
      </nav>
    </header>
    )}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <span>Designed and built by {site.name}</span>
      <span>© {year}</span>
    </footer>

    <dialog id="project-dialog" class="project-dialog" aria-labelledby="project-dialog-title">
      <button type="button" class="project-dialog-close" data-close-project>Close</button>
      <p class="eyebrow" data-project-kicker></p>
      <h2 id="project-dialog-title" data-project-title></h2>
      <p class="project-dialog-stat" data-project-stat hidden></p>
      <p class="project-dialog-summary" data-project-summary></p>
      <ul class="project-dialog-tags" data-project-tags></ul>
      <p class="project-dialog-links" data-project-links></p>
    </dialog>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--pad-x);
    top: -100%;
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.5rem 1rem;
    z-index: 100;
  }

  .skip-link:focus {
    top: 0;
    color: var(--on-accent);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px var(--pad-x);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    transition: background-color var(--transition), border-color var(--transition);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .wordmark {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-link {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }

  .contact-link:hover {
    border-color: var(--accent);
  }

  .project-dialog {
    width: min(34rem, calc(100vw - 2rem));
    max-height: min(78vh, 40rem);
    margin: auto;
    padding: 1.35rem 1.4rem 1.6rem;
    overflow: auto;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
  }

  .project-dialog [hidden] {
    display: none;
  }

  .project-dialog::backdrop {
    background: color-mix(in srgb, #000 64%, transparent);
  }

  .project-dialog-close {
    position: absolute;
    top: 0.85rem;
    inset-inline-end: 0.9rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-55);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .project-dialog-close:hover {
    color: var(--accent);
  }

  .project-dialog h2 {
    max-width: 18ch;
    margin: 0.35rem 2.5rem 0.7rem 0;
    font-size: clamp(1.55rem, 1.2rem + 1vw, 2.05rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .project-dialog-stat {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }

  .project-dialog-summary {
    margin: 0;
    max-width: 58ch;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-70);
  }

  .project-dialog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-dialog-tags li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-55);
    border: 1px solid var(--line);
    padding: 0.2rem 0.5rem;
  }

  .project-dialog-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.1rem 0 0;
  }

  .project-dialog-links a {
    color: var(--accent);
    font-size: 0.9rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 18px var(--pad-x);
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--ink-55);
  }

    @media (max-width: 980px) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 12px;
      padding-block: 14px;
    }

    .site-header nav {
      flex: 1 1 100%;
    }

    nav ul {
      flex-wrap: wrap;
      gap: 10px 16px;
    }
  }
</style>
