---
// "Practice" grid: four mono-labelled columns, per the design reference.
const groups = [
  {
    name: 'Languages & Backend',
    items: ['Python', 'TypeScript / Node.js', 'SQL'],
  },
  {
    name: 'AI & Automation',
    items: ['Generative AI & LLM APIs', 'AI Agents', 'n8n Workflow Automation', 'Business Automation'],
  },
  {
    name: 'Data & Infra',
    items: ['PostgreSQL', 'MongoDB', 'Firebase', 'Docker', 'REST APIs & Webhooks'],
  },
  {
    name: 'Tools & Platforms',
    items: ['Git', 'Cursor', 'Claude Code', 'Antigravity', 'Gemini'],
  },
];
---

<div class="practice">
  {
    groups.map((group) => (
      <div class="group">
        <h3>{group.name}</h3>
        <ul>
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .practice {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 36px;
  }

  h3 {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    font-size: var(--text-meta);
    color: var(--ink-85);
  }

  @media (max-width: 900px) {
    .practice {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .practice {
      grid-template-columns: 1fr;
    }
  }
</style>
