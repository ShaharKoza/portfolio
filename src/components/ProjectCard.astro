---
// One cell in the work spread. Every project uses the same scale.
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, tags, stat, year } = project.data;
const links = project.data.links ?? [];
const n = String(index).padStart(2, '0');
const label = stat ? `${title}. ${stat}` : title;
const payload = JSON.stringify({ title, year, stat: stat ?? '', summary, tags, links });
---

<button type="button" class="piece" data-project={payload} aria-label={label}>
  <span class="index">{n}</span>
  <span class="title">
    {title}
    <span class="go" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </span>
  {stat && <span class="stat">{stat}</span>}
  <span class="desc">{summary}</span>
  {tags.length > 0 && <span class="stack">{tags.join(' · ')}</span>}
</button>

<style>
  .piece {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    min-width: 0;
    color: var(--ink);
  }

  .piece:hover {
    color: var(--ink);
  }

  .index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--ink-45);
  }

  .title {
    font-size: clamp(1.35rem, 1.05rem + 0.7vw, 1.75rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .piece:hover .title {
    color: var(--accent);
  }

  .go {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-inline-start: 0.3em;
    opacity: 0;
    transform: translateX(-6px);
    vertical-align: 0.08em;
    transition: opacity var(--transition), transform var(--transition);
  }

  .go svg {
    width: 100%;
    height: 100%;
  }

  .piece:hover .go {
    opacity: 1;
    transform: none;
  }

  .stat {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.45;
    color: var(--accent);
  }

  .desc {
    max-width: 42ch;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-65);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stack {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-45);
  }

  @media (prefers-reduced-motion: reduce) {
    .go {
      transition: none;
    }

    .piece:hover .go {
      transform: none;
    }
  }
</style>
