---
import Base from '../../layouts/Base.astro';
import { getVisibleProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, year, tags, stat } = project.data;
const links = (project.data.links ?? []).filter((link) => link.href.startsWith('https://'));
---

<Base title={`${title} | Shahar Kozniak`} description={summary}>
  <article class="project container">
    <header class="page-header">
      <p class="eyebrow">Project · {year}</p>
      <h1>{title}</h1>
      {stat && <p class="stat">{stat}</p>}
      <p class="muted lede">{summary}</p>
      <ul class="tags" aria-label="Technologies">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
      {
        links.length > 0 && (
          <p class="links">
            {links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
            ))}
          </p>
        )
      }
    </header>

    <p class="back"><a href="/projects/">← All projects</a></p>
  </article>
</Base>

<style>
  .page-header {
    padding-block: var(--space-xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: var(--width-prose);
  }

  .stat {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }

  .page-header h1 {
    font-size: var(--text-title);
  }

  .lede {
    font-size: var(--text-md);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
  }

  .tags li {
    font-size: var(--text-micro);
    color: var(--ink-55);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.1rem 0.7rem;
  }

  .links {
    display: flex;
    gap: var(--space-lg);
    font-weight: 500;
  }

  .links a {
    color: var(--accent);
  }

  .back {
    margin-block: var(--space-2xl);
    font-size: var(--text-micro);
  }

  .back a {
    color: var(--ink-55);
  }

  .back a:hover {
    color: var(--accent);
  }
</style>
