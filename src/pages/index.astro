---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { PortfolioHero } from '../components/hero/PortfolioHero';

// Drafts stay visible in dev so they can be previewed, but never ship in a build.
const showDrafts = import.meta.env.DEV;

const featured = (
  await getCollection('projects', ({ data }) => (showDrafts || !data.draft) && data.featured)
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base
  title="Shahar Kozniak | AI & Automation Developer"
  description="Computer Science graduate building practical AI and automation systems: LLM agents, n8n workflows, and Python integrations."
  hideHeader
>
  <PortfolioHero client:load />

  <!-- WORK -->
  <section id="work" class="band" data-reveal>
    <div class="container section-pad work-pad">
      <div class="section-head">
        <h2>Selected Work</h2>
        <span class="section-num">01</span>
      </div>
      <div class="work-list work-spread">
        {featured.map((project, i) => <ProjectCard project={project} index={i + 1} />)}
      </div>
      <a class="link all-link" href="/projects/">All projects</a>
    </div>
  </section>

  <section id="experience" class="band" data-reveal>
    <div class="container section-pad about-grid">
      <div class="section-head about-head">
        <h2>Experience</h2>
        <span class="section-num">02</span>
      </div>
      <div>
        <div class="about-rows">
          <div class="about-row">
            <span class="about-key">AI &amp; Automation Developer</span>
            <span class="about-val">High Networks Ltd (2025–Present)</span>
          </div>
          <div class="about-row">
            <span class="about-key">NOC Engineer</span>
            <span class="about-val">Tevel Metro (2026–Present)</span>
          </div>
          <div class="about-row">
            <span class="about-key">IT Support Technician</span>
            <span class="about-val">Priority Software (2024–2025)</span>
          </div>
        </div>
        <p class="eyebrow edu-label">Education</p>
        <div class="about-rows">
          <div class="about-row">
            <span class="about-key">B.Sc. in Computer Science</span>
            <span class="about-val">Ono Academic College (Graduated 2026)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="band" data-reveal>
    <div class="container contact-pad">
      <div class="section-head">
        <h2>Contact</h2>
        <span class="section-num">03</span>
      </div>
      <p class="contact-lede">
        <a class="email" href="mailto:shaharkozniak@gmail.com">shaharkozniak@gmail.com</a>
      </p>
      <div class="contact-links">
        <a href="https://github.com/ShaharKoza">GitHub</a>
        <a href="https://www.linkedin.com/in/shahar-kozniak">LinkedIn</a>
        <a href="/Shahar-Kozniak-CV.pdf">CV</a>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="practice" class="band" data-reveal>
    <div class="container section-pad practice-pad">
      <div class="section-head">
        <h2>Practice</h2>
        <span class="section-num">04</span>
      </div>
      <SkillsMarquee />
    </div>
  </section>
</Base>

<style>
  .section-pad {
    padding-block: 56px 64px;
  }

  .work-pad {
    padding-top: 28px;
  }

  .all-link {
    display: inline-block;
    margin-top: 28px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 56px;
  }

  .about-head {
    margin-bottom: 0;
  }

  .edu-label {
    margin-top: 36px;
    margin-bottom: 8px;
  }

  .about-rows {
    display: flex;
    flex-direction: column;
  }

  .about-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    padding-block: 16px;
    border-top: 1px solid var(--line-soft);
  }

  .about-key {
    font-size: var(--text-meta);
    font-weight: 500;
  }

  .about-val {
    font-size: var(--text-meta);
    line-height: 1.65;
    color: var(--ink-65);
  }

  .contact-pad {
    padding-block: 56px 48px;
  }

  .practice-pad {
    padding-bottom: 80px;
  }

  .contact-lede {
    font-size: var(--text-title);
    line-height: 1.25;
    letter-spacing: -0.015em;
    max-width: 760px;
    margin-bottom: 36px;
    text-wrap: balance;
  }

  .email {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding-bottom: 2px;
  }

  .contact-links {
    display: flex;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-links a {
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }

  .contact-links a:hover {
    border-color: var(--accent);
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .about-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
